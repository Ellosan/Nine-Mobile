{
  "expo": {
    "name": "AgentKey",
    "slug": "agentkey",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "agentkey",
    "userInterfaceStyle": "dark",
    "platforms": ["android"],
    "android": {
      "package": "com.agentkey.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B0F14"
      },
      "permissions": ["android.permission.INTERNET"]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      "./plugins/withAgentKeyAndroid",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0F14",
          "imageWidth": 160
        }
      ]
    ]
  }
}
